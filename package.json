{
  "name": "route-leaf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Compile bounded XLSForms into context-specific paper interviewer cards",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "fixture": "node scripts/export-example.mjs",
    "check": "npm run build && npm test && npm run fixture",
    "serve": "node scripts/serve.mjs",
    "test:browser": "node tests/browser-test.mjs",
    "test:oracle": "node scripts/consumer-check.mjs engine",
    "package": "python3 scripts/package.py",
    "test:consumer-browser": "node scripts/consumer-check.mjs browser",
    "test:consumer-unit": "node scripts/consumer-check.mjs unit"
  },
  "dependencies": {
    "jszip": "3.10.1",
    "sax": "1.6.1",
    "pdf-lib": "1.17.1",
    "@pdf-lib/fontkit": "1.1.1",
    "pako": "1.0.11"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "esbuild": "0.25.11"
  }
}
